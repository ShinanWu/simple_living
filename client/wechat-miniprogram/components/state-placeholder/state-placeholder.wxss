.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx 40rpx;
  margin: 24rpx;
  min-height: 320rpx;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: saturate(180%) blur(24px);
  -webkit-backdrop-filter: saturate(180%) blur(24px);
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: 0 8px 32px rgba(24, 24, 27, 0.06);
}

.placeholder__title {
  color: var(--sl-text-secondary);
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 28rpx;
  text-align: center;
}

.placeholder__btn {
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  margin: 0;
}
