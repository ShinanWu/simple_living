.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
  min-height: 360rpx;
}

.placeholder__title {
  color: var(--sl-text-secondary);
  font-size: 28rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.placeholder__btn {
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}
