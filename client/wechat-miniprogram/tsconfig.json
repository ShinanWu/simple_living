{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020"],
    "typeRoots": ["./typings", "./node_modules/miniprogram-api-typings"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["./node_modules"]
}
