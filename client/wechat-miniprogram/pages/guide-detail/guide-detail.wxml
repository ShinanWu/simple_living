<view class="detail" style="{{pageStyle}}">
  <block wx:if="{{loadState === 'loading'}}">
    <view class="detail__center"><text class="sl-muted">加载详情中…</text></view>
  </block>
  <block wx:elif="{{loadState === 'offline'}}">
    <state-placeholder title="网络不可用" bind:action="onRetry" />
  </block>
  <block wx:elif="{{loadState === 'error'}}">
    <state-placeholder title="{{errorMessage}}" bind:action="onRetry" />
  </block>
  <block wx:else>
    <swiper class="detail__gallery" indicator-dots circular current="{{galleryIndex}}" bindchange="onGalleryChange">
      <swiper-item wx:for="{{gallerySlides}}" wx:key="index">
        <view class="detail__slide" style="background: {{item.bg}}">
          <image wx:if="{{item.url}}" class="detail__slide-img" src="{{item.url}}" mode="aspectFill" />
          <text wx:else class="detail__slide-emoji">{{item.emoji}}</text>
          <text class="detail__slide-caption sl-muted">{{item.caption}}</text>
        </view>
      </swiper-item>
    </swiper>
    <text class="detail__gallery-index sl-muted">{{galleryIndex + 1}}/{{gallerySlides.length}}</text>

    <scroll-view scroll-y class="detail__scroll" enhanced show-scrollbar="{{false}}">
      <view class="detail__content">
        <text class="detail__title">{{detail.title || previewTitle}}</text>
        <view wx:if="{{detail.isCommercial}}" class="detail__badge">合作推广</view>

        <view class="detail__section">
          <text class="detail__label sl-muted">推荐理由</text>
          <text class="detail__text">{{previewReasonDisplay}}</text>
        </view>

        <view class="detail__section">
          <text class="detail__label sl-muted">完整内容</text>
          <text class="detail__text">{{detail.summary}}</text>
        </view>

        <view class="detail__actions">
          <button class="sl-btn-ghost detail__btn" bindtap="onFavorite">{{favoriteLabel}}</button>
          <button class="sl-btn-primary detail__btn" bindtap="goBuy">去购买</button>
        </view>
      </view>
    </scroll-view>
  </block>
</view>
