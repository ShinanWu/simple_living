.home {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #fafafa 0%, color-mix(in srgb, var(--accent) 8%, #f4f4f5) 55%, #ececee 100%);
}

.home__topbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  margin-bottom: 12rpx;
}

.home__search {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: saturate(180%) blur(24px);
  -webkit-backdrop-filter: saturate(180%) blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: 0 2px 12px rgba(24, 24, 27, 0.04);
}

.home__search-icon {
  font-size: 28rpx;
}

.home__search-placeholder {
  font-size: 28rpx;
}

.home__me {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: saturate(180%) blur(24px);
  -webkit-backdrop-filter: saturate(180%) blur(24px);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: 0 2px 12px rgba(24, 24, 27, 0.04);
}

.home__me-icon {
  font-size: 36rpx;
}

.home__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
}

.home__loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home__pull-hint {
  text-align: center;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.home__card-wrap {
  flex: 1;
  min-height: 520rpx;
  overflow: hidden;
}

.home__card {
  height: 100%;
  min-height: 520rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: saturate(180%) blur(30px);
  -webkit-backdrop-filter: saturate(180%) blur(30px);
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: 0 8px 32px rgba(24, 24, 27, 0.07);
  transition: transform 0.26s cubic-bezier(0.22, 1, 0.36, 1);
}

.home__cover {
  border-radius: 24rpx;
  overflow: hidden;
  height: 420rpx;
  background: color-mix(in srgb, var(--accent) 18%, #fff);
}

.home__cover-img {
  width: 100%;
  height: 100%;
}

.home__cover-fallback {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home__cover-emoji {
  font-size: 96rpx;
}

.home__reason {
  margin-top: 24rpx;
}

.home__reason-label {
  font-size: 22rpx;
  font-weight: 600;
}

.home__reason-text {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 88rpx;
}

.home__index {
  margin-top: auto;
  padding-top: 16rpx;
  font-size: 24rpx;
}

.home__themes {
  position: relative;
  z-index: 20;
  flex-shrink: 0;
  display: flex;
  gap: 8rpx;
  padding: 10rpx;
  margin-top: 16rpx;
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: saturate(180%) blur(30px);
  -webkit-backdrop-filter: saturate(180%) blur(30px);
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: 0 4px 20px rgba(24, 24, 27, 0.05);
}

.home__theme-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--sl-text-secondary);
  transition: all 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

.home__theme-label {
  display: block;
  pointer-events: none;
}

.home__theme-item--pressed {
  opacity: 0.72;
}

.home__theme-item--active {
  background: rgba(255, 255, 255, 0.72);
  color: var(--sl-text);
  box-shadow: 0 4rpx 16rpx rgba(24, 24, 27, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.6);
}
