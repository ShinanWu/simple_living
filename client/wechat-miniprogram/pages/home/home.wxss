.home {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 100vh;
  padding: 16rpx 24rpx 0;
  gap: 10rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(180deg, #fafafa 0%, color-mix(in srgb, var(--accent) 8%, #f4f4f5) 55%, #ececee 100%);
}

.home__topbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  margin-bottom: 12rpx;
}

.home__search {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: saturate(180%) blur(24px);
  -webkit-backdrop-filter: saturate(180%) blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: 0 2px 12px rgba(24, 24, 27, 0.04);
}

.home__search-icon {
  font-size: 28rpx;
}

.home__search-placeholder {
  font-size: 28rpx;
}

.home__me {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: saturate(180%) blur(24px);
  -webkit-backdrop-filter: saturate(180%) blur(24px);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: 0 2px 12px rgba(24, 24, 27, 0.04);
}

.home__me-icon {
  font-size: 36rpx;
}

.home__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
}

.home__loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home__hint {
  text-align: center;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.home__swiper {
  flex: 1;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.home__swiper-item {
  height: 100%;
  box-sizing: border-box;
}

.home__scroll {
  height: 100%;
}

.home__card {
  height: 100%;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: saturate(180%) blur(30px);
  -webkit-backdrop-filter: saturate(180%) blur(30px);
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: 0 8px 32px rgba(24, 24, 27, 0.07);
}

.home__cover {
  flex: 1 1 auto;
  min-height: 280rpx;
  height: auto;
  max-height: 480rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: color-mix(in srgb, var(--accent) 18%, #fff);
}

.home__cover-img {
  width: 100%;
  height: 100%;
}

.home__cover-fallback {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home__cover-emoji {
  font-size: 96rpx;
}

.home__title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.home__reason {
  margin-top: 16rpx;
}

.home__reason-label {
  font-size: 22rpx;
  font-weight: 600;
}

.home__reason-text {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.home__footer {
  margin-top: auto;
  padding-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.home__index {
  font-size: 24rpx;
}

.home__actions {
  display: flex;
  gap: 16rpx;
}

.home__action-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  margin: 0;
  padding: 0;
}

.home__loading-more {
  text-align: center;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.home__back-top {
  position: fixed;
  right: 28rpx;
  bottom: calc(228rpx + env(safe-area-inset-bottom));
  z-index: 30;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 28px rgba(24, 24, 27, 0.12);
}

.home__back-top--pressed {
  opacity: 0.82;
  transform: scale(0.96);
}

.home__back-top-icon {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.home__back-top-label {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--sl-text-secondary);
}

.home__themes {
  position: relative;
  z-index: 20;
  flex-shrink: 0;
  display: flex;
  gap: 8rpx;
  padding: 10rpx;
  margin-top: 0;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: saturate(180%) blur(30px);
  -webkit-backdrop-filter: saturate(180%) blur(30px);
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: 0 4px 20px rgba(24, 24, 27, 0.05);
}

.home__theme-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--sl-text-secondary);
  transition: all 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

.home__theme-label {
  display: block;
  pointer-events: none;
}

.home__theme-item--pressed {
  opacity: 0.72;
}

.home__theme-item--active {
  background: rgba(255, 255, 255, 0.78);
  color: var(--tab-accent, var(--sl-text));
  box-shadow:
    0 4rpx 16rpx rgba(24, 24, 27, 0.06),
    0 0 0 1rpx color-mix(in srgb, var(--tab-accent, #18181b) 22%, transparent),
    inset 0 1px 0 rgba(255, 255, 255, 0.65);
}

.home__empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 36rpx;
  text-align: center;
  min-height: 480rpx;
}

.home__empty-icon {
  font-size: 80rpx;
  line-height: 1;
}

.home__empty-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.home__empty-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  max-width: 480rpx;
}

.home__empty-actions {
  margin-top: 36rpx;
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.home__empty-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  margin: 0;
  padding: 0;
}
