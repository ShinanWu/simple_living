<view class="list-page">
  <block wx:if="{{loadState === 'loading'}}">
    <view class="list-page__center"><text class="sl-muted">加载中…</text></view>
  </block>
  <block wx:elif="{{loadState === 'offline'}}">
    <state-placeholder title="网络不可用" bind:action="onRetry" />
  </block>
  <block wx:elif="{{loadState === 'error'}}">
    <state-placeholder title="{{errorMessage}}" bind:action="onRetry" />
  </block>
  <block wx:elif="{{loadState === 'empty'}}">
    <state-placeholder title="暂无收藏" actionTitle="" />
  </block>
  <block wx:else>
    <view wx:for="{{items}}" wx:key="favoriteId" class="list-page__item sl-card">
      <view class="list-page__main" data-id="{{item.guideCardId}}" bindtap="openDetail">
        <text class="list-page__title">{{item.guideCardId}}</text>
        <text class="list-page__meta sl-muted">收藏于 {{item.displayTime}}</text>
      </view>
      <button
        class="list-page__remove sl-btn-ghost"
        data-fid="{{item.favoriteId}}"
        catchtap="onRemove"
        loading="{{removingId === item.favoriteId}}"
        disabled="{{!!removingId}}"
      >
        取消
      </button>
    </view>
  </block>
</view>
