<view class="list-page">
  <block wx:if="{{loadState === 'loading'}}">
    <view class="list-page__center"><text class="sl-muted">加载中…</text></view>
  </block>
  <block wx:elif="{{loadState === 'error'}}">
    <state-placeholder title="{{errorMessage}}" bind:action="onRetry" />
  </block>
  <block wx:elif="{{!items.length}}">
    <state-placeholder title="暂无收藏" actionTitle="" />
  </block>
  <block wx:else>
    <view wx:for="{{items}}" wx:key="favoriteId" class="list-page__item sl-card" data-id="{{item.guideCardId}}" bindtap="openDetail">
      <text class="list-page__title">{{item.guideCardId}}</text>
      <text class="list-page__meta sl-muted">{{item.favoritedAt}}</text>
    </view>
  </block>
</view>
