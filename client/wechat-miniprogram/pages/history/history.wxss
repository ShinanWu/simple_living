.list-page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fafafa 0%, #f0f0f2 55%, #e8e8ea 100%);
}

.list-page__toolbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.list-page__clear {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  padding: 0 28rpx;
  margin: 0;
}

.list-page__center {
  min-height: 40vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.list-page__item {
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.list-page__title {
  font-size: 30rpx;
  font-weight: 600;
  word-break: break-all;
}

.list-page__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}
