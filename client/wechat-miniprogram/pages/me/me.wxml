<view class="me">
  <block wx:if="{{loadState === 'loading'}}">
    <view class="me__center"><text class="sl-muted">加载中…</text></view>
  </block>
  <block wx:elif="{{loadState === 'offline'}}">
    <state-placeholder title="网络不可用" bind:action="onRetry" />
  </block>
  <block wx:elif="{{loadState === 'error'}}">
    <state-placeholder title="{{errorMessage}}" bind:action="onRetry" />
  </block>
  <block wx:else>
    <view class="me__profile sl-card">
      <view class="me__avatar">{{avatarEmoji}}</view>
      <view class="me__info">
        <text class="me__name">{{displayName}}</text>
        <text class="me__status sl-muted">{{statusText}}</text>
      </view>
      <button wx:if="{{isLoggedIn}}" class="sl-btn-ghost me__auth-btn" bindtap="onLogout" loading="{{loggingOut}}">退出</button>
      <button wx:else class="sl-btn-primary me__auth-btn" bindtap="goLogin">登录</button>
    </view>

    <view class="me__stats sl-card">
      <view class="me__stat">
        <text class="me__stat-num">{{favoritesCount}}</text>
        <text class="me__stat-label sl-muted">收藏</text>
      </view>
      <view class="me__stat">
        <text class="me__stat-num">{{historyCount}}</text>
        <text class="me__stat-label sl-muted">历史</text>
      </view>
    </view>

    <view class="me__menu sl-card">
      <view class="me__menu-item" bindtap="goFavorites">
        <text>我的收藏</text>
        <text class="sl-muted">›</text>
      </view>
      <view class="me__menu-item" bindtap="goHistory">
        <text>浏览历史</text>
        <text class="sl-muted">›</text>
      </view>
    </view>

    <view class="me__consent sl-card">
      <text class="me__consent-text sl-muted">隐私授权：{{consentText}}</text>
    </view>
  </block>
</view>
