.me {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fafafa 0%, #f0f0f2 55%, #e8e8ea 100%);
}

.me__center {
  min-height: 50vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.me__profile {
  display: flex;
  align-items: center;
  padding: 28rpx;
  gap: 20rpx;
}

.me__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(228, 228, 231, 0.6);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.me__info {
  flex: 1;
  min-width: 0;
}

.me__name {
  font-size: 34rpx;
  font-weight: 700;
}

.me__status {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
}

.me__auth-btn {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
}

.me__stats {
  margin-top: 20rpx;
  display: flex;
  padding: 28rpx 0;
}

.me__stat {
  flex: 1;
  text-align: center;
}

.me__stat-num {
  font-size: 40rpx;
  font-weight: 700;
}

.me__stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
}

.me__menu {
  margin-top: 20rpx;
  overflow: hidden;
}

.me__menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid rgba(24, 24, 27, 0.04);
  font-size: 30rpx;
  transition: background 0.2s;
}

.me__menu-item:active {
  background: rgba(255, 255, 255, 0.3);
}

.me__menu-item:last-child {
  border-bottom: none;
}

.me__consent {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
}

.me__consent-text {
  font-size: 24rpx;
}
