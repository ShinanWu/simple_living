.login {
  padding: 48rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fafafa 0%, #f0f0f2 55%, #e8e8ea 100%);
}

.login__hero {
  margin-bottom: 48rpx;
}

.login__title {
  font-size: 44rpx;
  font-weight: 700;
}

.login__subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.login__wx {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
}

.login__divider {
  text-align: center;
  margin: 36rpx 0 24rpx;
  font-size: 24rpx;
}

.login__form {
  padding: 28rpx;
}

.login__input {
  background: rgba(244, 244, 245, 0.6);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  padding: 0 24rpx;
  height: 88rpx;
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.login__otp-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.login__input--otp {
  flex: 1;
  margin-bottom: 0;
}

.login__send {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 26rpx;
  padding: 0 20rpx;
  white-space: nowrap;
}

.login__phone-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.login__legal {
  margin-top: 32rpx;
  font-size: 22rpx;
  line-height: 1.55;
}

.login__error {
  margin-top: 24rpx;
  padding: 20rpx;
  background: rgba(254, 242, 242, 0.75);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  color: #b91c1c;
  border-radius: 16rpx;
  border: 1rpx solid rgba(254, 242, 242, 0.5);
  font-size: 26rpx;
}

.login__advanced {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
}
