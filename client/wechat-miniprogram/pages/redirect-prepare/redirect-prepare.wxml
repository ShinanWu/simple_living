<view class="redirect">
  <block wx:if="{{loadState === 'loading'}}">
    <view class="redirect__center">
      <text class="sl-muted">生成跳转链接中…</text>
    </view>
  </block>
  <block wx:elif="{{loadState === 'offline'}}">
    <state-placeholder title="网络不可用" bind:action="onRetry" />
  </block>
  <block wx:elif="{{loadState === 'error'}}">
    <state-placeholder title="{{errorMessage}}" bind:action="onRetry" />
  </block>
  <block wx:else>
    <view class="redirect__panel sl-card">
      <text class="redirect__headline">即将跳转</text>
      <text class="redirect__meta sl-muted">guide_card_id: {{guideCardId}}</text>
      <text class="redirect__label sl-muted">landing_url</text>
      <text class="redirect__url" selectable>{{landingUrl}}</text>
      <view class="redirect__actions">
        <button class="sl-btn-ghost redirect__btn" bindtap="onCopy">复制链接</button>
        <button class="sl-btn-primary redirect__btn" bindtap="onOpen">打开链接</button>
      </view>
      <text class="redirect__hint sl-muted">外链需在小程序后台配置业务域名；否则请使用复制链接。</text>
    </view>
  </block>
</view>
