# Lab + runtime service ports (single source of truth).
# Guest brpc services use --network host: container listens on the same port as the guest.
# Mac QEMU host-forwards use the same port on both sides: localhost:<port> → guest:<port>.

SERVICE_PORT_USER_SERVER=9101
SERVICE_PORT_RECOMMENDATION_SERVER=9103
SERVICE_PORT_TRACKING_SERVER=9105
SERVICE_PORT_BACKOFFICE_BACKEND=9110
SERVICE_PORT_GATEWAY_HTTP=8080
SERVICE_PORT_BACKOFFICE_WEB=8088
SERVICE_PORT_PROXY_HTTP=80

# Foundation (single QEMU guest; Mac host-forward uses the same port numbers).
SERVICE_PORT_FOUNDATION_POSTGRES=5432
SERVICE_PORT_FOUNDATION_REDIS=6379
SERVICE_PORT_FOUNDATION_KAFKA=9092

# Other QEMU guests reach Mac-published service ports via the slirp gateway.
LAB_QEMU_GATEWAY_HOST=10.0.2.2
