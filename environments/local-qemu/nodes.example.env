# Copy this file to nodes.env and fill real values.
# Service ports: environments/local-qemu/lab-ports.env (do not duplicate here).

# SSH settings
SSH_USER=your_ssh_user
SSH_KEY_PATH=~/.ssh/your_private_key
SSH_PORT=22

# Optional per-node SSH ports (override SSH_PORT).
NODE_SSH_PORT_BUILD=
NODE_SSH_PORT_GATEWAY=
NODE_SSH_PORT_USER=
NODE_SSH_PORT_BACKOFFICE=
NODE_SSH_PORT_RECOMMENDATION=
NODE_SSH_PORT_TRACKING=
NODE_SSH_PORT_NGINX=
NODE_SSH_PORT_BACKOFFICE_WEB=
NODE_SSH_PORT_FRPC=
NODE_SSH_PORT_FOUNDATION=

# Container image settings
# When REGISTRY is empty, images are pulled from default registry namespace.
REGISTRY=
IMAGE_TAG=latest

# Service node IPs
NODE_IP_BUILD=192.0.2.9
NODE_IP_GATEWAY=192.0.2.10
NODE_IP_USER=192.0.2.11
NODE_IP_BACKOFFICE=192.0.2.12
NODE_IP_RECOMMENDATION=192.0.2.13
NODE_IP_TRACKING=192.0.2.15

# Infra node IPs (for ingress/frpc related operations)
NODE_IP_NGINX=192.0.2.20
NODE_IP_BACKOFFICE_WEB=
NODE_IP_FRPC=192.0.2.21
NODE_IP_FOUNDATION=192.0.2.22

# Shared snapshot export directory (backoffice-backend writes; recommendation-server + tracking-server read).
EXPORT_DIR=/var/lib/simple-living/exports
SNAPSHOT_DIR=/var/lib/simple-living/exports

# Lab only: install inotify fan-out on backoffice guest (auto-push after export). Off when sharing one disk.
ENABLE_SNAPSHOT_FANOUT=1

# Foundation connection (ports from lab-ports.env: 5432 / 6379 / 9092).
POSTGRES_HOST=10.0.2.2
POSTGRES_PORT=5432
POSTGRES_DB=simple_living
POSTGRES_USER=simple
POSTGRES_PASSWORD=simple
REDIS_HOST=10.0.2.2
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=10.0.2.2:9092

# Build workspace path on build QEMU node.
QEMU_BUILD_WORKDIR=/root/simple_living

# Optional: proxy → 远端公网 frps（与 services/proxy/README.md 一致）
# ENABLE_FRP=1
# FRP_EMBEDDED=0
# FRP_PROXY_TYPE=http
# FRP_SERVER_ADDR=8.152.103.12
# FRP_SERVER_PORT=7000
# FRP_AUTH_TOKEN=与 VPS /etc/frp/frps.toml 中 auth.token 一致
# FRP_CUSTOM_DOMAIN=8.152.103.12
# FRP_USER=phase1-local-gateway
#
# Lab HTTPS ingress + 运营素材公网基址（与 FRP_CUSTOM_DOMAIN 一致；gateway 注入
# -gateway_backoffice_media_public_base_url）。ENABLE_INGRESS_HTTPS=1 时 deploy 默认 https://${FRP_CUSTOM_DOMAIN}
ENABLE_INGRESS_HTTPS=1
# 公网 IP 作 FRP_CUSTOM_DOMAIN 时，素材 HTTPS 默认 https://<ip-with-dashes>.nip.io
# GATEWAY_MEDIA_PUBLIC_BASE_URL=https://8-152-103-12.nip.io
#
# 内嵌 frps（无独立 VPS 时）见 services/proxy/deploy/README.md §5.3
# FRP_EMBEDDED=1
# FRP_PROXY_TYPE=tcp
# FRP_REMOTE_PORT=10080
