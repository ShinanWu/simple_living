# Copy this file to nodes.env and fill real values.

# SSH settings
SSH_USER=your_ssh_user
SSH_KEY_PATH=~/.ssh/your_private_key
SSH_PORT=22

# Optional per-node SSH ports (override SSH_PORT).
NODE_SSH_PORT_BUILD=
NODE_SSH_PORT_GATEWAY=
NODE_SSH_PORT_USER=
NODE_SSH_PORT_CONTENT=
NODE_SSH_PORT_RECOMMENDATION=
NODE_SSH_PORT_AFFILIATE=
NODE_SSH_PORT_TRACKING=
NODE_SSH_PORT_GOVERNANCE=
NODE_SSH_PORT_NGINX=
NODE_SSH_PORT_BACKOFFICE_WEB=
NODE_SSH_PORT_FRPC=

# Container image settings
# When REGISTRY is empty, images are pulled from default registry namespace.
REGISTRY=
IMAGE_TAG=latest

# Service node IPs
NODE_IP_BUILD=192.0.2.9
NODE_IP_GATEWAY=192.0.2.10
NODE_IP_USER=192.0.2.11
NODE_IP_CONTENT=192.0.2.12
NODE_IP_RECOMMENDATION=192.0.2.13
NODE_IP_AFFILIATE=192.0.2.14
NODE_IP_TRACKING=192.0.2.15
NODE_IP_GOVERNANCE=192.0.2.16

# Infra node IPs (for ingress/frpc related operations)
NODE_IP_NGINX=192.0.2.20
NODE_IP_BACKOFFICE_WEB=
NODE_IP_FRPC=192.0.2.21

# Build workspace path on build QEMU node.
QEMU_BUILD_WORKDIR=/root/simple_living

# Optional: proxy → 远端公网 frps（与 services/proxy/docs/README.md 一致）
# ENABLE_FRP=1
# FRP_EMBEDDED=0
# FRP_PROXY_TYPE=http
# FRP_SERVER_ADDR=8.152.103.12
# FRP_SERVER_PORT=7000
# FRP_AUTH_TOKEN=与 VPS /etc/frp/frps.toml 中 auth.token 一致
# FRP_CUSTOM_DOMAIN=8.152.103.12
# FRP_USER=phase1-local-gateway
#
# 内嵌 frps（无独立 VPS 时）见 services/proxy/deploy/README.md §5.3
# FRP_EMBEDDED=1
# FRP_PROXY_TYPE=tcp
# FRP_REMOTE_PORT=10080
