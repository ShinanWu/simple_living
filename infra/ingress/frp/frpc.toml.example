serverAddr = "8.152.103.12"
serverPort = 7000

auth.method = "token"
auth.token = "REPLACE_WITH_SAME_TOKEN_AS_FRPS"

# Optional stable identity for this client.
user = "phase1-local-gateway"

[[proxies]]
name = "gateway-http"
type = "http"
localIP = "127.0.0.1"
localPort = 80
# Use your real public domain here. If you access by IP, set to that IP.
customDomains = ["8.152.103.12"]

# HTTPS proxy is intentionally disabled in current phase.
# Enable later when domain/SNI/certificate is ready.
# [[proxies]]
# name = "gateway-https"
# type = "https"
# localIP = "127.0.0.1"
# localPort = 443
# customDomains = ["api.example.com"]
