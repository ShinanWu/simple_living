# brpc + patched deps (leveldb/openssl) live on Secretflow's registry; keep BCR first.
# Use GitHub raw mirror for BCR to avoid regional connectivity issues.
common --registry=https://raw.githubusercontent.com/bazelbuild/bazel-central-registry/main
common --registry=https://raw.githubusercontent.com/secretflow/bazel-registry/main

build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

# On Alibaba Cloud Linux (RHEL8-based), cc1plus may live in /usr/libexec/gcc.
# Enable this mount only when explicitly building with `--config=aliyun`.
build:aliyun --sandbox_add_mount_pair=/usr/libexec/gcc
