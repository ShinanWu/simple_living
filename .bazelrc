# brpc + patched deps (leveldb/openssl) live on Secretflow's registry; keep BCR first.
common --registry=https://bcr.bazel.build
common --registry=https://raw.githubusercontent.com/secretflow/bazel-registry/main

build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

# On Alibaba Cloud Linux (RHEL8-based), cc1plus lives in /usr/libexec/gcc which
# is outside the default sandbox. Mount it in so GCC can find its C++ frontend.
build --sandbox_add_mount_pair=/usr/libexec/gcc
