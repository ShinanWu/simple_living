load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//build:brpc_copts.bzl", "BRPC_EXAMPLE_COPTS")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "proto_files",
    srcs = glob(["proto/*.proto"]),
)

filegroup(
    name = "docs",
    srcs = glob(["docs/**/*.md"]),
)

proto_library(
    name = "governance_domain_proto",
    srcs = ["proto/governance_domain.proto"],
    strip_import_prefix = "proto",
    deps = ["@com_google_protobuf//:timestamp_proto"],
)

cc_proto_library(
    name = "governance_domain_cc_proto",
    deps = [":governance_domain_proto"],
)

cc_binary(
    name = "governance_domain_server",
    srcs = ["src/governance_domain_server_main.cpp"],
    copts = BRPC_EXAMPLE_COPTS,
    deps = [
        ":governance_domain_cc_proto",
        "@brpc//:brpc",
    ],
)
