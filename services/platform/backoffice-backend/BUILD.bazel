load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//build_defs:brpc_copts.bzl", "BRPC_EXAMPLE_COPTS")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "proto_files",
    srcs = glob(["proto/*.proto"]),
)

filegroup(
    name = "docs",
    srcs = glob(["docs/**/*.md"]),
)

proto_library(
    name = "governance_server_proto",
    srcs = ["proto/governance_server.proto"],
    strip_import_prefix = "proto",
)

cc_proto_library(
    name = "governance_server_cc_proto",
    deps = [":governance_server_proto"],
)

proto_library(
    name = "affiliate_server_proto",
    srcs = ["proto/affiliate_server.proto"],
    strip_import_prefix = "proto",
)

cc_proto_library(
    name = "affiliate_server_cc_proto",
    deps = [":affiliate_server_proto"],
)

cc_library(
    name = "pg_content_store",
    srcs = ["src/pg_content_store.cpp"],
    hdrs = ["src/pg_content_store.h"],
    copts = BRPC_EXAMPLE_COPTS + select({
        "@platforms//os:linux": ["-I/usr/include/postgresql"],
        "//conditions:default": [],
    }),
    linkopts = ["-lpq"],
    deps = [
        "//common/proto:catalog_cc_proto",
        "@brpc//:brpc",
    ],
)

cc_library(
    name = "pg_governance_store",
    srcs = ["src/pg_governance_store.cpp"],
    hdrs = ["src/pg_governance_store.h"],
    copts = BRPC_EXAMPLE_COPTS + select({
        "@platforms//os:linux": ["-I/usr/include/postgresql"],
        "//conditions:default": [],
    }),
    linkopts = ["-lpq"],
    deps = [
        "//common/proto:catalog_cc_proto",
        ":governance_server_cc_proto",
        "@brpc//:brpc",
    ],
)

cc_library(
    name = "pg_affiliate_store",
    srcs = ["src/pg_affiliate_store.cpp"],
    hdrs = ["src/pg_affiliate_store.h"],
    copts = BRPC_EXAMPLE_COPTS + select({
        "@platforms//os:linux": ["-I/usr/include/postgresql"],
        "//conditions:default": [],
    }),
    linkopts = ["-lpq"],
    deps = [
        ":affiliate_server_cc_proto",
        "@brpc//:brpc",
    ],
)

cc_library(
    name = "dev_content_seeds",
    hdrs = ["src/dev_content_seeds.h"],
    includes = ["src"],
)

cc_library(
    name = "export_publisher",
    srcs = ["src/export_publisher.cpp"],
    hdrs = ["src/export_publisher.h"],
    copts = BRPC_EXAMPLE_COPTS,
    deps = [
        "//common/proto:catalog_cc_proto",
        "@com_google_protobuf//:protobuf",
    ],
)

cc_library(
    name = "backoffice_modules",
    srcs = [
        "src/affiliate_services.cpp",
        "src/content_services.cpp",
        "src/governance_services.cpp",
        "src/snapshot_export.cpp",
    ],
    hdrs = [
        "src/backoffice_module.h",
        "src/snapshot_export.h",
    ],
    copts = BRPC_EXAMPLE_COPTS,
    deps = [
        ":affiliate_server_cc_proto",
        "//common/proto:catalog_cc_proto",
        "//common/proto:content_service_cc_proto",
        ":export_publisher",
        ":governance_server_cc_proto",
        ":pg_affiliate_store",
        ":pg_content_store",
        ":pg_governance_store",
        ":dev_content_seeds",
        "@brpc//:brpc",
    ],
)

cc_binary(
    name = "backoffice_backend_server",
    srcs = ["src/backoffice_backend_server_main.cpp"],
    copts = BRPC_EXAMPLE_COPTS,
    deps = [
        ":backoffice_modules",
        ":export_publisher",
        "@brpc//:brpc",
    ],
)

sh_test(
    name = "backoffice_backend_contract_smoke_test",
    srcs = ["tests/backoffice_backend_contract_smoke_test.sh"],
    data = [
        "//common/proto:catalog.proto",
        "//common/proto:content_service.proto",
        "src/backoffice_backend_server_main.cpp",
        "src/export_publisher.cpp",
    ],
)
