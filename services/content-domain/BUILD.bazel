load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//build:brpc_copts.bzl", "BRPC_EXAMPLE_COPTS")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "proto_files",
    srcs = glob(["proto/*.proto"]),
)

filegroup(
    name = "docs",
    srcs = glob(["docs/**/*.md"]),
)

proto_library(
    name = "content_domain_proto",
    srcs = ["proto/content_domain.proto"],
    strip_import_prefix = "proto",
    deps = [
        "@com_google_protobuf//:field_mask_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

cc_proto_library(
    name = "content_domain_cc_proto",
    deps = [":content_domain_proto"],
)

cc_binary(
    name = "content_domain_server",
    srcs = ["src/content_domain_server_main.cpp"],
    copts = BRPC_EXAMPLE_COPTS,
    deps = [
        ":content_domain_cc_proto",
        "@brpc//:brpc",
    ],
)
