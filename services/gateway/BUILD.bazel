load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//build:brpc_copts.bzl", "BRPC_EXAMPLE_COPTS")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "proto_files",
    srcs = glob(["proto/*.proto"]),
)

filegroup(
    name = "docs",
    srcs = glob(["docs/**/*.md"]),
)

proto_library(
    name = "gateway_user_proto",
    srcs = [
        "proto/gateway_user_edge.proto",
        "proto/gateway_user_http_messages.proto",
    ],
    strip_import_prefix = "proto",
    deps = [
        "//services/user-domain:user_domain_proto",
        "@com_google_protobuf//:empty_proto",
    ],
)

cc_proto_library(
    name = "gateway_user_cc_proto",
    deps = [":gateway_user_proto"],
)

proto_library(
    name = "gateway_pages_proto",
    srcs = ["proto/gateway_pages_edge.proto"],
    strip_import_prefix = "proto",
    deps = ["@com_google_protobuf//:timestamp_proto"],
)

cc_proto_library(
    name = "gateway_pages_cc_proto",
    deps = [":gateway_pages_proto"],
)

cc_binary(
    name = "gateway_edge_server",
    srcs = ["src/gateway_edge_server_main.cpp"],
    copts = BRPC_EXAMPLE_COPTS,
    deps = [
        ":gateway_pages_cc_proto",
        ":gateway_user_cc_proto",
        "//services/user-domain:user_domain_cc_proto",
        "//services/content-domain:content_domain_cc_proto",
        "//services/recommendation-domain:recommendation_domain_cc_proto",
        "//services/tracking-domain:tracking_domain_cc_proto",
        "@brpc//:brpc",
        "@com_google_protobuf//:protobuf",
    ],
)

sh_test(
    name = "gateway_contract_smoke_test",
    srcs = ["tests/gateway_contract_smoke_test.sh"],
    data = [
        "proto/gateway_pages_edge.proto",
        "src/gateway_edge_server_main.cpp",
    ],
)

sh_test(
    name = "gateway_pages_golden_contract_test",
    srcs = ["tests/gateway_pages_golden_contract_test.sh"],
    data = [
        "docs/api.md",
        "proto/gateway_pages_edge.proto",
        "src/gateway_edge_server_main.cpp",
    ],
)

sh_test(
    name = "gateway_user_golden_contract_test",
    srcs = ["tests/gateway_user_golden_contract_test.sh"],
    data = [
        "docs/api.md",
        "proto/gateway_user_edge.proto",
        "proto/gateway_user_http_messages.proto",
        "src/gateway_edge_server_main.cpp",
    ],
)
