load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//build_defs:brpc_copts.bzl", "BRPC_EXAMPLE_COPTS")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "proto_files",
    srcs = glob(["proto/*.proto"]),
)

filegroup(
    name = "docs",
    srcs = [
        "README.md",
        "api.md",
    ],
)

proto_library(
    name = "gateway_user_proto",
    srcs = [
        "proto/gateway_user_edge.proto",
        "proto/gateway_user_http_messages.proto",
    ],
    strip_import_prefix = "proto",
    deps = [
        "//services/user-server:user_server_proto",
        "@com_google_protobuf//:empty_proto",
    ],
)

cc_proto_library(
    name = "gateway_user_cc_proto",
    deps = [":gateway_user_proto"],
)

proto_library(
    name = "gateway_pages_proto",
    srcs = ["proto/gateway_pages_edge.proto"],
    strip_import_prefix = "proto",
    deps = [
        "@com_google_protobuf//:empty_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

cc_proto_library(
    name = "gateway_pages_cc_proto",
    deps = [":gateway_pages_proto"],
)

cc_library(
    name = "gateway_backoffice_helpers",
    srcs = ["src/gateway_backoffice_helpers.cpp"],
    hdrs = ["src/gateway_backoffice_helpers.h"],
    copts = BRPC_EXAMPLE_COPTS,
    includes = ["src"],
    deps = [
        ":gateway_backoffice_media",
        ":gateway_pages_cc_proto",
        "//common/proto:catalog_cc_proto",
        "//common/proto:content_service_cc_proto",
        "//services/platform/backoffice-backend:affiliate_server_cc_proto",
        "//services/platform/backoffice-backend:governance_server_cc_proto",
        "@brpc//:brpc",
        "@com_google_protobuf//:protobuf",
    ],
)

cc_library(
    name = "gateway_backoffice_media",
    srcs = ["src/gateway_backoffice_media.cpp"],
    hdrs = ["src/gateway_backoffice_media.h"],
    copts = BRPC_EXAMPLE_COPTS,
    includes = ["src"],
    deps = [
        ":gateway_pages_cc_proto",
        "@brpc//:brpc",
    ],
)

cc_library(
    name = "gateway_home_feed_helpers",
    srcs = ["src/gateway_home_feed_helpers.cpp"],
    hdrs = ["src/gateway_home_feed_helpers.h"],
    copts = BRPC_EXAMPLE_COPTS,
    includes = ["src"],
    deps = [
        ":gateway_backoffice_media",
        ":gateway_pages_cc_proto",
        "//common/proto:catalog_cc_proto",
        "@com_google_protobuf//:protobuf",
    ],
)

cc_library(
    name = "gateway_user_http_json",
    srcs = ["src/gateway_user_http_json.cpp"],
    hdrs = ["src/gateway_user_http_json.h"],
    copts = BRPC_EXAMPLE_COPTS,
    includes = ["src"],
    deps = [
        "//services/user-server:user_server_cc_proto",
        "@brpc//:brpc",
        "@com_google_protobuf//:protobuf",
    ],
)

cc_binary(
    name = "gateway_edge_server",
    srcs = ["src/gateway_edge_server_main.cpp"],
    copts = BRPC_EXAMPLE_COPTS,
    deps = [
        ":gateway_backoffice_helpers",
        ":gateway_backoffice_media",
        ":gateway_home_feed_helpers",
        ":gateway_user_http_json",
        ":gateway_pages_cc_proto",
        ":gateway_user_cc_proto",
        "//common/proto:catalog_cc_proto",
        "//common/proto:content_service_cc_proto",
        "//services/platform/backoffice-backend:affiliate_server_cc_proto",
        "//services/platform/backoffice-backend:governance_server_cc_proto",
        "//services/tracking-server:tracking_server_cc_proto",
        "//services/user-server:user_server_cc_proto",
        "@brpc//:brpc",
        "@com_google_protobuf//:protobuf",
    ],
)

sh_test(
    name = "gateway_pages_golden_contract_test",
    srcs = ["tests/gateway_pages_golden_contract_test.sh"],
    data = [
        "api.md",
        "proto/gateway_pages_edge.proto",
        "src/gateway_edge_server_main.cpp",
    ],
)

sh_test(
    name = "gateway_user_golden_contract_test",
    srcs = ["tests/gateway_user_golden_contract_test.sh"],
    data = [
        "api.md",
        "proto/gateway_user_edge.proto",
        "proto/gateway_user_http_messages.proto",
        "src/gateway_edge_server_main.cpp",
    ],
)

sh_test(
    name = "gateway_backoffice_contract_smoke_test",
    srcs = ["tests/gateway_backoffice_contract_smoke_test.sh"],
    data = [
        "proto/gateway_pages_edge.proto",
        "src/gateway_edge_server_main.cpp",
    ],
)
