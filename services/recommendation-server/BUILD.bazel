load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//build_defs:brpc_copts.bzl", "BRPC_EXAMPLE_COPTS")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "docs",
    srcs = [
        "README.md",
        "api.md",
    ],
)

filegroup(
    name = "proto_files",
    srcs = glob(["proto/*.proto"]),
)

proto_library(
    name = "recommendation_server_proto",
    srcs = glob(["proto/*.proto"]),
    strip_import_prefix = "proto",
    deps = ["//common/proto:catalog_proto"],
)

cc_proto_library(
    name = "recommendation_server_cc_proto",
    deps = [":recommendation_server_proto"],
)

cc_library(
    name = "pg_recommendation_store",
    srcs = ["src/pg_recommendation_store.cpp"],
    hdrs = ["src/pg_recommendation_store.h"],
    copts = BRPC_EXAMPLE_COPTS + select({
        "@platforms//os:linux": ["-I/usr/include/postgresql"],
        "//conditions:default": [],
    }),
    linkopts = ["-lpq"],
    deps = [
        ":recommendation_server_cc_proto",
        "@brpc//:brpc",
    ],
)

cc_library(
    name = "snapshot_store",
    srcs = ["src/snapshot_store.cpp"],
    hdrs = ["src/snapshot_store.h"],
    copts = BRPC_EXAMPLE_COPTS,
    deps = [
        ":recommendation_server_cc_proto",
        "//common/proto:catalog_cc_proto",
        "@com_google_protobuf//:protobuf",
    ],
)

cc_library(
    name = "catalog_read_service",
    srcs = ["src/catalog_read_service.cpp"],
    hdrs = ["src/catalog_read_service.h"],
    copts = BRPC_EXAMPLE_COPTS,
    deps = [
        ":snapshot_store",
        "//common/proto:content_service_cc_proto",
        "@brpc//:brpc",
    ],
)

cc_binary(
    name = "recommendation_server",
    srcs = ["src/recommendation_server_main.cpp"],
    copts = BRPC_EXAMPLE_COPTS,
    deps = [
        ":catalog_read_service",
        ":pg_recommendation_store",
        ":recommendation_server_cc_proto",
        ":snapshot_store",
        "@brpc//:brpc",
    ],
)

sh_test(
    name = "recommendation_server_contract_smoke_test",
    srcs = ["tests/recommendation_server_contract_smoke_test.sh"],
    data = [
        "api.md",
        "src/catalog_read_service.cpp",
        "tests/fixtures/catalog.json",
    ],
)
