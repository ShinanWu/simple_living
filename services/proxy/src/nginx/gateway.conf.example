# Phase1 minimal public ingress:
# - Remote public host: frps exposes 80/443
# - Local private side: nginx terminates TLS and proxies to gateway service
# - gateway remains the only business public entry

upstream gateway_backend {
    # QEMU lab formal path:
    # frps(80) -> frpc(on nginx node) -> nginx(80) -> host-forwarded gateway(18080) -> gateway:8080
    server 10.0.2.2:18080;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    location = /healthz {
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://gateway_backend;
        proxy_http_version 1.1;

        # Preserve caller and ingress context for gateway.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 80;

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# HTTPS block intentionally omitted in current phase.
