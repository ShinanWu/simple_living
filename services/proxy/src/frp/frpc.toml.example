serverAddr = "REPLACE_WITH_FRPS_HOST"
serverPort = 7000

auth.method = "token"
auth.token = "REPLACE_WITH_SAME_TOKEN_AS_FRPS"

# Optional stable identity for this client.
user = "phase1-local-gateway"

[[proxies]]
name = "gateway-http"
type = "http"
localIP = "127.0.0.1"
localPort = 80
# Use your real public domain here. If you access by IP, set to that IP.
customDomains = ["REPLACE_WITH_PUBLIC_DOMAIN"]

# This template covers the HTTP proxy only. The deployed container generates its
# runtime frpc config (including the HTTPS proxy when ENABLE_INGRESS_HTTPS=1) via
# services/proxy/deploy/start_proxy.sh.
