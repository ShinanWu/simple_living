bindPort = 7000

# Public virtual-host ports exposed on remote host.
vhostHTTPPort = 80
vhostHTTPSPort = 443

# Authentication for frpc -> frps.
auth.method = "token"
auth.token = "REPLACE_WITH_STRONG_TOKEN"

