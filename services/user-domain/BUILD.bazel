load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_proto_library", "cc_test")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//build:brpc_copts.bzl", "BRPC_EXAMPLE_COPTS")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "proto_files",
    srcs = glob(["proto/*.proto"]),
)

filegroup(
    name = "docs",
    srcs = glob(["docs/**/*.md"]),
)

proto_library(
    name = "user_domain_proto",
    srcs = glob(["proto/*.proto"]),
    strip_import_prefix = "proto",
    deps = [
        "@com_google_protobuf//:timestamp_proto",
        "@com_google_protobuf//:wrappers_proto",
    ],
)

cc_proto_library(
    name = "user_domain_cc_proto",
    deps = [":user_domain_proto"],
)

cc_library(
    name = "pg_user_store",
    srcs = ["src/pg_user_store.cpp"],
    hdrs = ["src/pg_user_store.h"],
    copts = BRPC_EXAMPLE_COPTS + select({
        "@platforms//os:linux": ["-I/usr/include/postgresql"],
        "//conditions:default": [],
    }),
    linkopts = ["-lpq"],
    deps = [
        ":user_domain_cc_proto",
        "@brpc//:brpc",
    ],
)

cc_binary(
    name = "user_domain_server",
    srcs = ["src/user_domain_server_main.cpp"],
    copts = BRPC_EXAMPLE_COPTS,
    deps = [
        ":pg_user_store",
        ":user_domain_cc_proto",
        "@brpc//:brpc",
    ],
)

sh_test(
    name = "user_domain_store_smoke_test",
    srcs = ["tests/user_domain_store_smoke_test.sh"],
    data = [
        "src/pg_user_store.cpp",
        "src/pg_user_store.h",
    ],
)

cc_test(
    name = "pg_user_store_unit_test",
    srcs = ["tests/pg_user_store_unit_test.cpp"],
    deps = [
        ":pg_user_store",
    ],
)
